@model NitelikliKahve.Models.Equipment

@{
    ViewData["Title"] = "Equipment Details";
}

<h1>Details</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">MachineName</dt>
    <dd class="col-sm-10">@Model.MachineName</dd>

    <dt class="col-sm-2">GrinderName</dt>
    <dd class="col-sm-10">@Model.GrinderName</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
