@model NitelikliKahve.Models.Equipment

@{
    ViewData["Title"] = "Delete Equipment";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Equipment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">MachineName</dt>
        <dd class="col-sm-10">@Model.MachineName</dd>
        <dt class="col-sm-2">GrinderName</dt>
        <dd class="col-sm-10">@Model.GrinderName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
