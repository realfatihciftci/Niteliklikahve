@model NitelikliKahve.Models.Recipe

@{
    ViewData["Title"] = "Create Recipe";
}

<h1>Create Recipe</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="CoffeeBeanId" class="control-label">Coffee</label>
        @Html.DropDownListFor(m => m.CoffeeBeanId, (SelectList)ViewBag.CoffeeBeans, "-- Select Coffee --", new { @class = "form-control" })
        <span asp-validation-for="CoffeeBeanId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EquipmentId" class="control-label">Equipment</label>
        @Html.DropDownListFor(m => m.EquipmentId, (SelectList)ViewBag.Equipments, "-- Select Equipment --", new { @class = "form-control" })
        <span asp-validation-for="EquipmentId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Dose" class="control-label"></label>
        <input asp-for="Dose" class="form-control" />
        <span asp-validation-for="Dose" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Yield" class="control-label"></label>
        <input asp-for="Yield" class="form-control" />
        <span asp-validation-for="Yield" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BrewTime" class="control-label"></label>
        <input asp-for="BrewTime" class="form-control" />
        <span asp-validation-for="BrewTime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Rating" class="control-label"></label>
        <input asp-for="Rating" class="form-control" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
