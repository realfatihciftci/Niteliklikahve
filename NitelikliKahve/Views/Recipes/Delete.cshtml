@model NitelikliKahve.Models.Recipe

@{
    ViewData["Title"] = "Delete Recipe";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Recipe</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Coffee</dt>
        <dd class="col-sm-10">@Model.CoffeeBean?.Brand - @Model.CoffeeBean?.Origin</dd>
        <dt class="col-sm-2">Equipment</dt>
        <dd class="col-sm-10">@Model.Equipment?.MachineName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
