@model IEnumerable<NitelikliKahve.Models.CoffeeBean>

@{
    ViewData["Title"] = "Coffee Beans";
}

<h1>Coffee Beans</h1>

<p><a class="btn btn-primary" asp-action="Create">Create New</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Brand</th>
            <th>Origin</th>
            <th>Price (TL)</th>
            <th>Package (g)</th>
            <th>RoastLevel</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Brand</td>
            <td>@item.Origin</td>
            <td>@item.Price.ToString("F2")</td>
            <td>@item.PackageWeight</td>
            <td>@item.RoastLevel</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
