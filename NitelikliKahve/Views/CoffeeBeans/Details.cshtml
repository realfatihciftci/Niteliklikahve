@model NitelikliKahve.Models.CoffeeBean

@{
    ViewData["Title"] = "Coffee Bean Details";
}

<h1>Details</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Brand</dt>
    <dd class="col-sm-10">@Model.Brand</dd>

    <dt class="col-sm-2">Origin</dt>
    <dd class="col-sm-10">@Model.Origin</dd>

    <dt class="col-sm-2">RoastLevel</dt>
    <dd class="col-sm-10">@Model.RoastLevel</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
